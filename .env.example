# Postgres (Dev Container compose service hostname is `db`)
DATABASE_URL=postgresql://pdf_invoice_user:pdf_invoice_password@db:5432/pdf_invoice_db

# Shopify app (filled by `shopify app dev` / Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=https://example.com

# Optional: custom shop domain for development stores
# SHOP_CUSTOM_DOMAIN=

# App runtime
NODE_ENV=development
PORT=3000
# FRONTEND_PORT is usually injected by Shopify CLI
# FRONTEND_PORT=8002
